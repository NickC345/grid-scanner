# Password you type to open the scanner (required)
APP_PASSWORD=change-me

# DataForSEO API login (Dashboard -> API Access). Required unless DEMO_MODE=true.
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=your-api-password

# Optional: Google PageSpeed Insights API key. Works without one at low volume.
PAGESPEED_API_KEY=

# Optional: set to true to try the app with made-up sample data (no API calls, no cost)
DEMO_MODE=false

# Optional: where scan history is saved (default ./data)
DATA_DIR=
